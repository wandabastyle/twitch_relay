# Twitch Relay Configuration
# Copy this file to .env and fill in required values

# =============================================================================
# REQUIRED: Twitch OAuth
# =============================================================================
# Get these from your Twitch Developer Console:
# https://dev.twitch.tv/console
TWITCH_OAUTH_CLIENT_ID=
TWITCH_OAUTH_CLIENT_SECRET=
TWITCH_OAUTH_REDIRECT_URI=http://localhost:8080/api/twitch/callback

# Generate a secure 32-byte base64 key for token encryption
# Example: openssl rand -base64 32
TWITCH_TOKEN_ENCRYPTION_KEY=

# =============================================================================
# Server Configuration
# =============================================================================
BIND_ADDR=0.0.0.0:8080
AUTH_COOKIE_NAME=twitch_relay_session
AUTH_COOKIE_SECURE=false

# =============================================================================
# Stream/Playback Settings
# =============================================================================
WATCH_TICKET_TTL_SECS=60
STREAMLINK_PATH=streamlink
STREAM_RESOLVER_MODE=auto
STREAM_DELIVERY_MODE=cdn_first
TWITCH_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko

# =============================================================================
# Recording Settings
# =============================================================================
XDG_DATA_HOME=/data
RECORDINGS_DIR=/app/recordings
RECORDING_DEFAULT_QUALITY=best
RECORDING_POLL_INTERVAL_SECS=45
RECORDING_START_LIVE_CONFIRMATIONS=2
RECORDING_STOP_OFFLINE_CONFIRMATIONS=3
RECORDING_WRITE_NFO=true
FFMPEG_PATH=ffmpeg
RECORDING_CHAPTER_MIN_GAP_SECS=180
RECORDING_CHAPTER_CHANGE_CONFIRMATIONS=2

# =============================================================================
# Miscellaneous
# =============================================================================
# Rotate the access code on each restart if set to true
TWITCH_RELAY_ROTATE_PASSWORD=false

# =============================================================================
# OPTIONAL: Invidious/YouTube Integration
# =============================================================================
# YouTube mode is disabled unless both INVIDIOUS_BASE_URL and INVIDIOUS_TOKEN
# are configured. Used for fetching YouTube subscriptions and live streams.

# Base URL of your Invidious instance (must include http:// or https://)
# INVIDIOUS_BASE_URL=https://invidious.example.com

# API token from Invidious (required if base URL is set)
# INVIDIOUS_TOKEN=

# Optional: SID cookie for authentication (preferred when using basic auth)
# INVIDIOUS_SID=

# Optional: Basic auth credentials if Invidious is behind a reverse proxy
# INVIDIOUS_BASIC_AUTH_USER=
# INVIDIOUS_BASIC_AUTH_PASSWORD=
